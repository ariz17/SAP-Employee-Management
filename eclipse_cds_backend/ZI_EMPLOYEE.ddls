@AbapCatalog.sqlViewName: 'ZV_EMPLOYEE'
@AbapCatalog.compiler.compareFilter: true
@AbapCatalog.preserveKey: true
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Employee OData CDS View'
@OData.publish: true

define view ZI_EMPLOYEE
  as select from zemply_mng_dbtab
{
  key empid    as Empid,
      name     as Name,
      email    as Email,
      dept     as Department,
      salary   as Salary,
      joindate as JoinDate,
      status   as Status
}
