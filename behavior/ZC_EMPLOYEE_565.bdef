projection;
strict ( 2 );

define behavior for ZC_EMPLOYEE_DETAILS alias Employee
{
  use create;
  use update;
  use delete;

  use association _Leave { create; }

  // Exposing custom actions to the UI / OData V4 client
  use action giveRaise;
  use action changeStatus;
}

define behavior for ZC_EMPLOYEE_LEAVE alias LeaveRequest
{
  use update;
  use delete;

  use association _Employee;

  // Exposing leave approval action to the UI / OData V4 client
  use action approveLeave;
}
